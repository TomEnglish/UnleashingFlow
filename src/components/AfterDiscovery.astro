---
// What Discovery may recommend, whichever branch of the fork you took — we
// build these, or we teach your team to. The Throughput Cycle used to close
// this section; it now sits beside the retainer it contrasts against.
// Instrumentation leads, rendered as a full-width feature above the grid.
// Grounded in delivered work: GPS and geofencing plus scan-at-handoff capture
// on the laydown-yard platform, vision-model reading of paper slips on the
// franchise build.
const instrumentation = {
  name: 'Instrumentation — making the missing number exist',
  body: 'The constraint usually sits in the part of the operation nobody measures, because no system was ever pointed at it. We put sensors and capture software where the work actually happens, so the number you need starts existing instead of being estimated.',
  examples: [
    'GPS and geofencing on vehicles and equipment',
    'A scan at each material handoff, working offline',
    'Vision models reading the paperwork still filled in by hand',
    'Feeds pulled off machines that already publish data',
  ],
};

const builds = [
  {
    name: 'Integrated reporting & dashboards',
    body: 'The live view of margin, throughput, capacity, and cash you assumed you already had. Built once the underlying data can actually support it.',
  },
  {
    name: 'Custom apps & automations',
    body: 'Web and mobile tools designed for how your operation genuinely runs — offline-first field apps, reconciliation workflows, inventory, scheduling. Plus the workflow automations underneath them: the email that goes out when a KPI crosses a line, and the business rules that fire without anyone remembering to check.',
  },
  {
    name: 'AI upskilling',
    body: 'Hands-on training on the systems your people actually touch, with follow-up so the habit survives the first busy week.',
  },
  {
    name: 'Online presence rebuild',
    body: 'Website, local search, and reviews working as one system — for the operations where the constraint turns out to be demand, not capacity.',
  },
];
---

<section id="what-we-build" class="build section surface-ivory">
  <div class="section-inner">
    <div class="section-head section-head-center reveal">
      <p class="section-label">After Discovery</p>
      <h2 class="section-title">What gets built, once we know what to build.</h2>
      <p class="section-desc">
        None of these are entry doors. They are what Discovery may recommend —
        and only when the data, the systems, and the team can carry them.
      </p>
    </div>

    <div class="sequence reveal">
      <h3 class="sequence-title">The path is the same. What sits inside it is not.</h3>
      <p class="sequence-para">
        Data integration comes first, almost without exception. Not because it
        is exciting, but because nothing above it works until the systems can
        talk. Then dashboards and KPIs, which is usually the first time a
        business writes its own rules down in a form anyone else can read. Only
        then does the consulting get useful, because now we are both looking at
        the same numbers instead of arguing about whose gut is right.
      </p>
      <p class="sequence-para">
        That last part gets more specific to your business the further in we go.
        The first module looks broadly similar across a franchise operator and a
        machinery manufacturer. The last one does not look like anybody else's.
      </p>
      <p class="sequence-claim">
        The sequence does not change. The names always do. By the time you see
        your roadmap it is written in your language, about your operation, and
        the only thing borrowed from anyone else is the order we do it in.
      </p>
    </div>

    <article class="instrument reveal">
      <div class="instrument-copy">
        <h3 class="instrument-name">{instrumentation.name}</h3>
        <p class="instrument-body">{instrumentation.body}</p>
      </div>
      <ul class="ticks instrument-list">
        {instrumentation.examples.map(x => <li>{x}</li>)}
      </ul>
    </article>

    <div class="build-grid">
      {builds.map((b, i) => (
        <article class="build-card reveal" style={`--reveal-delay: ${i * 70}ms`}>
          <h3 class="build-name">{b.name}</h3>
          <p class="build-body">{b.body}</p>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  /* The three-module sequence is already the spine of every proposal written
     so far — data first, then the view, then the tools and the judgment on
     top — arrived at independently each time. Naming it here is what lets the
     closing line land: competitors sell a named framework and ask the client
     to learn it; we do the reverse. */
  .sequence {
    max-width: var(--measure);
    margin: 0 auto clamp(32px, 4vw, 48px);
    text-align: center;
  }

  .sequence-title {
    font-size: var(--step-h3);
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: var(--space-5);
    line-height: 1.3;
  }

  .sequence-para {
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--warm-gray);
    text-align: left;
  }

  .sequence-para + .sequence-para {
    margin-top: var(--space-4);
  }

  .sequence-claim {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.75;
    color: var(--charcoal);
    text-align: left;
    margin-top: var(--space-5);
    padding-left: var(--space-5);
    border-left: 2px solid var(--terracotta);
  }

  .build-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(18px, 2.2vw, 24px);
  }

  /* Instrumentation leads: it answers the objection the rest of the page
     invites — "we don't have numbers for that part of the operation." */
  .instrument {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(24px, 3.4vw, 48px);
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--terracotta);
    border-radius: var(--radius);
    padding: clamp(26px, 3.2vw, 38px);
    box-shadow: var(--shadow-md);
    margin-bottom: clamp(18px, 2.2vw, 24px);
  }

  .instrument-name {
    font-size: var(--step-h3);
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: var(--space-4);
    line-height: 1.25;
  }

  .instrument-body {
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--warm-gray);
  }

  .instrument-list {
    background: var(--ivory);
    border-radius: var(--radius-sm);
    padding: var(--space-5);
  }

  @media (max-width: 860px) {
    .instrument { grid-template-columns: 1fr; }
  }

  .build-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: clamp(24px, 2.8vw, 32px);
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease),
                opacity 0.7s var(--ease);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .build-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .build-name {
    font-size: 17.5px;
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: var(--space-3);
    line-height: 1.3;
  }

  .build-body {
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--warm-gray);
  }

  @media (max-width: 860px) {
    .build-grid { grid-template-columns: 1fr; }
  }
</style>
