---
interface Props {
  src: string;
  title?: string;
}

const { src, title = 'Listen to this digest' } = Astro.props;
---

<div class="audio-player">
  <p class="audio-label">{title}</p>
  <audio controls preload="metadata">
    <source src={src} type="audio/mpeg" />
    Your browser does not support the audio element.
  </audio>
</div>

<style>
  .audio-player {
    background: var(--ivory-dark);
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 32px;
  }

  .audio-label {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--warm-gray);
    margin-bottom: 12px;
  }

  audio {
    width: 100%;
    height: 40px;
  }
</style>
