---
// Google Calendar appointment-schedule embed.
// Both URLs live in src/config/booking.ts — change the calendar there.
import { BOOKING_URL, BOOKING_EMBED_URL } from '../config/booking';

interface Props {
  url?: string;
}

const { url = BOOKING_EMBED_URL } = Astro.props;
---

<div class="booking-wrapper">
  <iframe
    src={url}
    style="border: 0"
    width="100%"
    height="630"
    frameborder="0"
    title="Book Discovery"
  ></iframe>
  <p class="booking-fallback">
    Calendar not loading? <a href={BOOKING_URL} target="_blank" rel="noopener">Open the booking page directly</a>.
  </p>
</div>

<style>
  .booking-wrapper {
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #E8E0D6;
  }

  .booking-fallback {
    font-family: var(--font-heading);
    font-size: 12px;
    color: var(--warm-gray);
    text-align: center;
    padding: 10px 16px 14px;
    margin: 0;
  }

  .booking-fallback a {
    color: var(--terracotta);
  }
</style>
