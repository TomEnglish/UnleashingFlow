---
import BookingEmbed from './BookingEmbed.astro';

// Both partners are reachable now — Mac's details were missing from the site
// entirely before this rework.
const contacts = [
  {
    name: 'Elliott English',
    role: 'Operations & Build',
    email: 'elliott@unleashingflow.com',
    linkedin: 'https://linkedin.com/in/elliottenglish',
    linkedinLabel: 'in/elliottenglish',
  },
  {
    name: 'Mac Steele',
    role: 'Business Development',
    email: 'mac@unleashingflow.com',
    linkedin: null,
    linkedinLabel: null,
  },
];
---

<section id="contact" class="contact section surface-dark">
  <div class="section-inner">
    <div class="section-head section-head-center reveal">
      <p class="section-label">Get in touch</p>
      <h2 class="section-title">Start with Discovery.</h2>
      <p class="section-desc">
        Two to three weeks, a fixed fee from $5,000, and a written answer about
        where your operation is actually blocked. If we are not the right people
        for it, we will usually know someone who is — and we will say so on the
        first call rather than the fourth.
      </p>
    </div>

    <div class="booking-col reveal">
      <BookingEmbed />
    </div>

    <div class="contact-cards reveal">
      {contacts.map(c => (
        <div class="contact-card">
          <h3 class="contact-name">{c.name}</h3>
          <p class="contact-role">{c.role}</p>
          <a class="contact-link" href={`mailto:${c.email}`}>{c.email}</a>
          {c.linkedin && (
            <a class="contact-link contact-link-sub" href={c.linkedin} target="_blank" rel="noopener">
              {c.linkedinLabel}
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .booking-col {
    max-width: 820px;
    margin: 0 auto;
  }

  .contact-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(18px, 2.4vw, 24px);
    max-width: 820px;
    margin: clamp(28px, 3.5vw, 40px) auto 0;
  }

  .contact-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--hairline-dark);
    border-radius: var(--radius);
    padding: var(--space-6);
    text-align: center;
  }

  .contact-name {
    font-size: 17px;
    font-weight: 700;
    color: var(--ivory);
    margin-bottom: 6px;
  }

  .contact-role {
    font-family: var(--font-heading);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--terracotta-light);
    margin-bottom: var(--space-4);
  }

  .contact-link {
    display: block;
    font-family: var(--font-heading);
    font-size: 14.5px;
    color: var(--ivory);
    text-decoration: none;
    transition: color 0.2s var(--ease);
    word-break: break-word;
  }

  .contact-link:hover { color: var(--terracotta-light); }

  .contact-link-sub {
    font-size: 13px;
    color: var(--taupe);
    margin-top: 6px;
  }

  @media (max-width: 640px) {
    .contact-cards { grid-template-columns: 1fr; }
  }
</style>
