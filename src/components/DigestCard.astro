---
interface Props {
  title: string;
  date: Date;
  description?: string;
  storyCount?: number;
  slug: string;
  hasAudio?: boolean;
}

const { title, date, description, storyCount, slug, hasAudio } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={`/the-current/${slug}`} class="digest-card">
  <div class="digest-meta">
    <time datetime={date.toISOString().split('T')[0]}>{formattedDate}</time>
    {storyCount && <span class="story-count">{storyCount} stories</span>}
    {hasAudio && <span class="has-audio">Audio</span>}
  </div>
  <h3 class="digest-title">{title}</h3>
  {description && <p class="digest-desc">{description}</p>}
</a>

<style>
  .digest-card {
    display: block;
    background: #fff;
    border: 1px solid #E8E0D6;
    border-radius: 12px;
    padding: 28px 24px;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .digest-card:hover {
    border-color: var(--terracotta);
    box-shadow: 0 2px 12px rgba(169, 121, 103, 0.08);
  }

  .digest-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  time {
    font-family: var(--font-heading);
    font-size: 12px;
    color: var(--warm-gray);
    letter-spacing: 1px;
  }

  .story-count,
  .has-audio {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 20px;
  }

  .story-count {
    background: var(--ivory-dark);
    color: var(--warm-gray);
  }

  .has-audio {
    background: var(--terracotta-light);
    color: var(--charcoal);
  }

  .digest-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: 6px;
  }

  .digest-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--warm-gray);
  }
</style>
