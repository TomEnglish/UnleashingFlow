---
// One-page "How it works" section — merges the old ValueProp pillars with the
// Services-page Discovery card and deliverables checklist.
const pillars = [
  {
    title: 'Listen',
    body: 'What you\'re trying to fix, what "better" looks like, and where the operation actually hurts — before we talk tools.',
  },
  {
    title: 'Data readiness',
    body: 'Whether your current systems can support integrated reporting or AI — what connects today, what doesn\'t, and what would need to.',
  },
  {
    title: 'Team AI skills',
    body: 'Where your people are strong, where they\'re stuck, and whether staff training would help before any build will stick.',
  },
];

const deliverables = [
  'Listening session — what you\'re trying to fix, and what "better" looks like',
  'Data readiness assessment — systems, sources, and whether they can support integrated reporting or AI',
  'Integration map — what connects today, what doesn\'t, and what would need to',
  'Team AI skills evaluation — where your people are strong, where they\'re stuck, and whether training would help',
  'Honest readiness verdict — ready now, ready after a few fixes, or not yet',
  'Recommended next step — scoped only if Discovery says it\'s worth doing',
];
---

<section id="how-it-works" class="discovery-section section">
  <p class="section-label">How it works</p>
  <h2 class="section-title">One entry door: Discovery</h2>
  <p class="section-desc">
    Discovery is a Data Readiness Audit. Every client starts here. We listen to what you need, check whether your systems are ready for integrated reporting or AI, and evaluate your team's AI skills at the same time. What comes next is decided by what we find — not by a menu of projects.
  </p>

  <div class="pillar-grid">
    {pillars.map(pillar => (
      <div class="pillar-card">
        <h3 class="pillar-title">{pillar.title}</h3>
        <p class="pillar-body">{pillar.body}</p>
      </div>
    ))}
  </div>

  <article class="discovery-card">
    <div class="discovery-card-body">
      <div class="discovery-narrative">
        <p class="discovery-lead">
          Some businesses are ready to build. Some need a few data fixes first. Some need the team brought up to speed before any tool will stick. Discovery tells you which — honestly — before you fund the wrong next step.
        </p>
        <p class="door-shape-line">Fixed-scope first engagement</p>
        <a href="https://calendar.app.google/L5y5Lhqab7ocFmYL6" target="_blank" rel="noopener" class="btn btn-primary">Book Discovery</a>
      </div>
      <div class="door-deliverables">
        <p class="deliverables-label">What you get</p>
        <ul class="deliverables-list">
          {deliverables.map(d => <li>{d}</li>)}
        </ul>
      </div>
    </div>
  </article>
</section>

<style>
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 8px;
  }

  .pillar-card {
    background: #fff;
    border: 1px solid #E8E0D6;
    border-radius: 16px;
    padding: 32px 28px;
  }

  .pillar-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--charcoal);
    line-height: 1.25;
  }

  .pillar-body {
    font-size: 15px;
    line-height: 1.65;
    color: var(--charcoal);
    margin: 0;
  }

  .discovery-card {
    margin-top: 32px;
    background: #fff;
    border: 1px solid var(--terracotta);
    border-radius: 20px;
    padding: 40px;
  }

  .discovery-card-body {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 36px;
    align-items: start;
  }

  .discovery-lead {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.7;
    color: var(--charcoal);
    margin-bottom: 16px;
  }

  .door-shape-line {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--terracotta);
    margin: 16px 0 24px;
  }

  .door-deliverables {
    background: var(--ivory);
    border-radius: 16px;
    padding: 24px;
  }

  .deliverables-label {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 12px;
  }

  .deliverables-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .deliverables-list li {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.55;
    color: var(--charcoal);
    padding-left: 20px;
    position: relative;
  }

  .deliverables-list li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--terracotta);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .pillar-grid {
      grid-template-columns: 1fr;
    }

    .discovery-card {
      padding: 24px 22px;
    }

    .discovery-card-body {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
