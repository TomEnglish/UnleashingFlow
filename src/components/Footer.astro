---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src="/images/logo-unleashing-flow-dark.svg" alt="Unleashing Flow" class="footer-logo" />
      <p class="footer-tagline">
        Find the bottleneck. Build the AI. Unlock the throughput.
      </p>
    </div>

    <nav class="footer-cols" aria-label="Footer">
      <div class="footer-col">
        <h2 class="footer-heading">Contact</h2>
        <a href="mailto:elliott@unleashingflow.com">elliott@unleashingflow.com</a>
        <a href="mailto:mac@unleashingflow.com">mac@unleashingflow.com</a>
        <a href="https://linkedin.com/in/elliottenglish" target="_blank" rel="noopener">LinkedIn</a>
      </div>

      <div class="footer-col">
        <h2 class="footer-heading">The site</h2>
        <a href="/#fractional">Fractional AI Officer</a>
        <a href="/#discovery">Discovery</a>
        <a href="/#who-its-for">Who it's for</a>
        <a href="/data-trust">How your data is handled</a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} Unleashing Flow LLC. All rights reserved.</p>
    <p class="footer-locale">Campobello, South Carolina · Serving operators nationally</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--deep-brown);
    color: var(--ivory);
    padding: clamp(48px, 6vw, 72px) var(--gutter) var(--space-6);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto clamp(32px, 4vw, 48px);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: clamp(32px, 5vw, 72px);
    flex-wrap: wrap;
  }

  .footer-brand {
    max-width: 320px;
  }

  .footer-logo {
    height: 34px;
    margin-bottom: var(--space-4);
  }

  .footer-tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 14.5px;
    color: var(--taupe);
    line-height: 1.65;
  }

  .footer-cols {
    display: flex;
    gap: clamp(40px, 6vw, 80px);
    flex-wrap: wrap;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--terracotta-light);
    margin-bottom: 2px;
  }

  .footer-col a {
    font-family: var(--font-heading);
    font-size: 13.5px;
    color: var(--taupe);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .footer-col a:hover { color: var(--ivory); }

  .footer-bottom {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-top: var(--space-5);
    border-top: 1px solid var(--hairline-dark);
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer-bottom p {
    font-family: var(--font-heading);
    font-size: 11.5px;
    color: var(--warm-gray);
  }

  @media (max-width: 700px) {
    .footer-inner { flex-direction: column; }
  }
</style>
