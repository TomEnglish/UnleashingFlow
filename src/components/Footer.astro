---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src="/images/logo-unleashing-flow-dark.svg" alt="Unleashing Flow" class="footer-logo" />
      <p class="footer-tagline">Find the bottleneck. Build the AI. Unlock the throughput.</p>
    </div>

    <div class="footer-links">
      <div class="footer-col">
        <h4>Navigate</h4>
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/methodology">Methodology</a>
        <a href="/constraints">Constraints</a>
        <a href="/contact">Contact</a>
      </div>
      <div class="footer-col">
        <h4>Connect</h4>
        <a href="https://linkedin.com/in/elliottenglish" target="_blank" rel="noopener">LinkedIn</a>
        <a href="mailto:elliott@unleashingflow.com">Email</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} Unleashing Flow. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--charcoal);
    color: var(--ivory);
    padding: 60px 60px 24px;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 48px;
  }

  .footer-brand {
    max-width: 320px;
  }

  .footer-logo {
    height: 32px;
    margin-bottom: 16px;
  }

  .footer-tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 14px;
    color: var(--taupe);
    line-height: 1.6;
  }

  .footer-links {
    display: flex;
    gap: 60px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col h4 {
    font-family: var(--font-heading);
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--terracotta-light);
    margin-bottom: 4px;
    font-weight: 600;
  }

  .footer-col a {
    font-family: var(--font-heading);
    font-size: 13px;
    color: var(--taupe);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--ivory);
  }

  .footer-bottom {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-top: 24px;
    border-top: 1px solid #4A3F3C;
  }

  .footer-bottom p {
    font-family: var(--font-heading);
    font-size: 12px;
    color: var(--warm-gray);
  }

  @media (max-width: 768px) {
    .site-footer {
      padding: 40px 24px 20px;
    }

    .footer-inner {
      flex-direction: column;
      gap: 32px;
    }

    .footer-links {
      gap: 40px;
    }
  }
</style>
