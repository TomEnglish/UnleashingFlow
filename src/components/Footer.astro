---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src="/images/logo-unleashing-flow-dark.svg" alt="Unleashing Flow" class="footer-logo" />
      <p class="footer-tagline">Start with Discovery. Find the constraint. Build the fix.</p>
    </div>

    <div class="footer-links">
      <a href="mailto:elliott@unleashingflow.com">elliott@unleashingflow.com</a>
      <a href="https://linkedin.com/in/elliottenglish" target="_blank" rel="noopener">LinkedIn</a>
      <a href="/data-trust">How Your Data Is Handled</a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} Unleashing Flow. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--charcoal);
    color: var(--ivory);
    padding: 48px 60px 24px;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto 36px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }

  .footer-brand {
    max-width: 320px;
  }

  .footer-logo {
    height: 32px;
    margin-bottom: 16px;
  }

  .footer-tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 14px;
    color: var(--taupe);
    line-height: 1.6;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: right;
  }

  .footer-links a {
    font-family: var(--font-heading);
    font-size: 13px;
    color: var(--taupe);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--ivory);
  }

  .footer-bottom {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-top: 24px;
    border-top: 1px solid #4A3F3C;
  }

  .footer-bottom p {
    font-family: var(--font-heading);
    font-size: 12px;
    color: var(--warm-gray);
  }

  @media (max-width: 768px) {
    .site-footer {
      padding: 40px 24px 20px;
    }

    .footer-inner {
      flex-direction: column;
      gap: 28px;
    }

    .footer-links {
      text-align: left;
    }
  }
</style>
