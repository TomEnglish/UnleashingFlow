---
import { BOOKING_URL } from '../config/booking';

// Anchor nav for the one-page site. Links use /#id so they also work from
// standalone pages like /data-trust.
const navLinks = [
  { href: '/#fractional', label: 'Fractional AI Officer' },
  { href: '/#discovery', label: 'Discovery' },
  { href: '/#who-its-for', label: "Who It's For" },
  { href: '/#about', label: 'About' },
];
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo-link" aria-label="Unleashing Flow — Home">
      <img src="/images/logo-unleashing-flow-light.svg" alt="Unleashing Flow" class="logo" />
    </a>

    <nav class="nav-desktop" aria-label="Main navigation">
      {navLinks.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="btn btn-primary nav-cta">
        Book Discovery
      </a>
    </nav>

    <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <nav class="nav-mobile" aria-label="Mobile navigation">
    {navLinks.map(link => (
      <a href={link.href} class="nav-link">{link.label}</a>
    ))}
    <a href={BOOKING_URL} target="_blank" rel="noopener" class="btn btn-primary nav-cta">
      Book Discovery
    </a>
  </nav>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = document.querySelector('.menu-toggle');
  const mobileNav = document.querySelector('.nav-mobile');

  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    mobileNav?.classList.remove('open');
    toggle?.classList.remove('open');
  };

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    mobileNav?.classList.toggle('open');
    toggle.classList.toggle('open');
  });

  // Close the mobile menu after an anchor link is tapped, since the page
  // doesn't reload on same-page navigation.
  mobileNav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Lift the header off the page once it stops sitting on the hero.
  const onScroll = () => {
    header?.classList.toggle('is-stuck', window.scrollY > 8);
  };

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 247, 242, 0.86);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .site-header.is-stuck {
    border-bottom-color: var(--hairline);
    box-shadow: 0 1px 20px rgba(61, 51, 48, 0.06);
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 14px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo {
    height: 34px;
    width: auto;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--warm-gray);
    text-decoration: none;
    transition: color 0.2s var(--ease);
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--charcoal);
  }

  .nav-cta {
    padding: 11px 22px;
    font-size: 11px;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .bar {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--charcoal);
    border-radius: 2px;
    transition: all 0.3s var(--ease);
  }

  .menu-toggle.open .bar:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .menu-toggle.open .bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.open .bar:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  .nav-mobile {
    display: none;
    flex-direction: column;
    align-items: stretch;
    text-align: center;
    gap: var(--space-5);
    padding: var(--space-6) var(--gutter) var(--space-7);
    background: var(--ivory);
    border-bottom: 1px solid var(--hairline);
  }

  .nav-mobile.open {
    display: flex;
  }

  @media (max-width: 980px) {
    .nav-desktop {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }
  }
</style>
