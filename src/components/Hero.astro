---
import { BOOKING_URL } from '../config/booking';
---

<section class="hero surface-dark">
  <div class="hero-inner section-inner">
    <p class="hero-label reveal">Fractional AI leadership for operators</p>

    <h1 class="hero-title reveal" style="--reveal-delay: 60ms">
      Your business runs at the speed of
      <span class="accent">whatever is blocking it.</span>
    </h1>

    <p class="hero-subtitle reveal" style="--reveal-delay: 120ms">
      Somewhere in your operation the work stops moving. Orders sit. Cash sits.
      Every decision queues behind you. We find that one place using your own
      numbers, clear it, and build the tools that keep it clear. AI is how we do
      that in weeks instead of quarters — it isn't what we're selling.
    </p>

    <div class="hero-actions reveal" style="--reveal-delay: 180ms">
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="btn btn-primary">
        Book Discovery — from $5,000
      </a>
      <a href="#how-we-work" class="btn btn-outline">See how we work</a>
    </div>
  </div>
</section>

<style>
  .hero {
    /* The mark is a waterfall; the wash suggests flow without illustrating it. */
    background:
      radial-gradient(ellipse 900px 520px at 50% -10%, rgba(169, 121, 103, 0.30), transparent 70%),
      var(--charcoal);
    padding: clamp(88px, 12vw, 150px) var(--gutter) clamp(72px, 9vw, 110px);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    max-width: 940px;
    position: relative;
    z-index: 1;
  }

  .hero-label {
    font-family: var(--font-heading);
    font-size: var(--step-eyebrow);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--terracotta-light);
    margin-bottom: var(--space-6);
    font-weight: 600;
  }

  .hero-title {
    font-size: var(--step-display);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-6);
    color: var(--ivory);
    /* Constrained so `balance` splits it evenly instead of orphaning a word. */
    max-width: 20ch;
    margin-left: auto;
    margin-right: auto;
    text-wrap: balance;
  }

  .hero-title .accent {
    color: var(--terracotta-light);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: var(--step-lead);
    line-height: 1.7;
    color: var(--taupe);
    max-width: 660px;
    margin: 0 auto var(--space-8);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Stagger the reveal of the hero stack. */
  .hero .reveal {
    transition-delay: var(--reveal-delay, 0ms);
  }

  @media (max-width: 640px) {
    /* 20ch is narrower than a phone screen, which stacks the headline into
       five short lines. Let it use the full column instead. */
    .hero-title {
      max-width: none;
    }

    .hero-subtitle {
      font-size: 16px;
      line-height: 1.65;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions .btn { width: 100%; }
  }
</style>
