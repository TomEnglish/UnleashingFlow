---
// The build-or-teach fork, on the page for the first time. Decided 11 August:
// after Discovery the client picks who does the work, and most take some of
// each. Until now the site only sold the retainer, which read as one product.
//
// Cards 1 and 2 are the fork and carry equal weight. Card 3 is deliberately
// quieter — the retainer is what follows either branch, not a third door in.
const ways = [
  {
    name: 'We build it.',
    body: 'The fastest route. We connect the systems, build the tools, and stay on to run and improve them. You are reading your own numbers inside a quarter.',
    lead: true,
  },
  {
    name: 'We teach your team.',
    body: 'Slower to value, cheaper over time, and you own it at the end. We hand over the methods and the tooling, then stay close enough that the habit survives the first busy week.',
    lead: true,
  },
  {
    name: 'We hold the seat.',
    body: 'For operators who need the function and not the hire. Whichever branch you took, this is what staying looks like — senior operational leadership on a monthly cadence, from the two people who built the systems in the first place.',
    lead: false,
    href: '#fractional',
    linkLabel: 'The retainer, in detail',
  },
];
---

<section id="how-we-work" class="how section surface-ivory">
  <div class="section-inner">
    <div class="section-head section-head-center reveal">
      <p class="section-label">After Discovery</p>
      <h2 class="section-title">Three ways in. Most operators end up using two of them.</h2>
      <p class="section-desc">
        We find where a business is choking and put a number on it. Then you
        decide who clears it — us, or your own people with our methods in their
        hands. That choice gets made from what Discovery found, not from a
        package you picked before anyone looked.
      </p>
    </div>

    <div class="ways-grid">
      {ways.map((w, i) => (
        <article
          class:list={['way-card', 'reveal', { 'way-card-lead': w.lead }]}
          style={`--reveal-delay: ${i * 90}ms`}
        >
          <h3 class="way-name">{w.name}</h3>
          <p class="way-body">{w.body}</p>
          {w.href && <a class="way-link" href={w.href}>{w.linkLabel}</a>}
        </article>
      ))}
    </div>

    <p class="ways-close reveal">
      Build the part that has to work now. Learn the part you should own
      forever. We will tell you which is which, and sometimes the answer is
      that you do not need us for either.
    </p>
  </div>
</section>

<style>
  .ways-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(18px, 2.4vw, 26px);
    align-items: stretch;
  }

  .way-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: clamp(26px, 3vw, 36px);
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease),
                opacity 0.7s var(--ease);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .way-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  /* The two delivery options lead; the retainer card stays quieter. */
  .way-card-lead {
    border-color: var(--terracotta);
    box-shadow: var(--shadow-md);
  }

  .way-name {
    font-size: var(--step-h3);
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: var(--space-4);
    line-height: 1.25;
  }

  .way-body {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--warm-gray);
  }

  .way-link {
    font-family: var(--font-heading);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracotta);
    text-decoration: none;
    margin-top: auto;
    padding-top: var(--space-5);
    transition: color 0.2s var(--ease);
  }

  .way-link:hover { color: var(--terracotta-deep); }

  .ways-close {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.75;
    color: var(--charcoal);
    max-width: var(--measure);
    margin: clamp(28px, 3.5vw, 40px) auto 0;
    padding-left: var(--space-5);
    border-left: 2px solid var(--terracotta);
  }

  @media (max-width: 900px) {
    .ways-grid { grid-template-columns: 1fr; }
  }
</style>
