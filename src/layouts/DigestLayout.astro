---
import PageLayout from './PageLayout.astro';
import AudioPlayer from '../components/AudioPlayer.astro';

interface Props {
  title: string;
  date: Date;
  description?: string;
  audioFile?: string;
}

const { title, date, description, audioFile } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<PageLayout title={title} description={description || title} type="article">
  <article class="digest-page">
    <div class="digest-header">
      <a href="/the-current" class="back-link">&larr; Back to The Current</a>
      <time datetime={date.toISOString().split('T')[0]}>{formattedDate}</time>
    </div>

    {audioFile && (
      <AudioPlayer src={audioFile} title="Listen to this digest" />
    )}

    <div class="digest-content">
      <slot />
    </div>
  </article>
</PageLayout>

<style>
  .digest-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 60px 80px;
  }

  .digest-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .back-link {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 500;
    color: var(--terracotta);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--charcoal);
  }

  time {
    font-family: var(--font-heading);
    font-size: 12px;
    color: var(--warm-gray);
    letter-spacing: 1px;
  }

  .digest-content {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.8;
    color: var(--charcoal);
  }

  .digest-content :global(h1) {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 800;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .digest-content :global(h2) {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
    margin-top: 48px;
    margin-bottom: 16px;
    color: var(--charcoal);
  }

  .digest-content :global(h3) {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 600;
    margin-top: 32px;
    margin-bottom: 12px;
    color: var(--charcoal);
  }

  .digest-content :global(p) {
    margin-bottom: 16px;
  }

  .digest-content :global(ul),
  .digest-content :global(ol) {
    margin-bottom: 16px;
    padding-left: 24px;
  }

  .digest-content :global(li) {
    margin-bottom: 8px;
  }

  .digest-content :global(hr) {
    border: none;
    border-top: 1px solid #E8E0D6;
    margin: 40px 0;
  }

  .digest-content :global(strong) {
    color: var(--charcoal);
    font-weight: 600;
  }

  .digest-content :global(a) {
    color: var(--terracotta);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .digest-content :global(a:hover) {
    color: var(--charcoal);
  }

  .digest-content :global(blockquote) {
    border-left: 3px solid var(--terracotta);
    padding-left: 20px;
    margin: 24px 0;
    color: var(--warm-gray);
    font-style: italic;
  }

  .digest-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-family: var(--font-heading);
    font-size: 14px;
  }

  .digest-content :global(th) {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 2px solid var(--terracotta);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--warm-gray);
  }

  .digest-content :global(td) {
    padding: 10px 12px;
    border-bottom: 1px solid #E8E0D6;
  }

  @media (max-width: 768px) {
    .digest-page {
      padding: 32px 24px 60px;
    }
  }
</style>
