---
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/CTASection.astro';

const categories = [
  {
    number: '01',
    name: 'Equipment / Production Capacity',
    description: 'A physical resource is at 100% utilization during your revenue-weighted peak. The bottleneck is something you could in principle buy more of, if buying more were the right move.',
    signs: [
      'A specific machine or workstation has a queue forming during peak hours',
      'You routinely tell customers "we can\'t take any more orders this week"',
      'Your team works around the limitation rather than naming it',
    ],
    examples: 'A bakery\'s deck oven. A manufacturer\'s CNC machine. An agency\'s review pipeline. A clinic\'s exam rooms. A restaurant\'s grill station.',
  },
  {
    number: '02',
    name: 'Skilled Labor Hours',
    description: 'A specific role has limited capacity. The constraint isn\'t equipment or space — it\'s how many hours a particular kind of person can put in.',
    signs: [
      'When one person is out, certain work simply stops',
      'Overtime is concentrated in a single role',
      'There\'s a waitlist for one person\'s time, not the team\'s',
    ],
    examples: 'Head baker. Lead decorator. Senior partner at a law or accounting firm. Master engineer. Lead nurse practitioner.',
  },
  {
    number: '03',
    name: 'Skill Concentration',
    description: 'Only one trained person knows how to perform a critical operation. Goldratt\'s "bus factor of one." The business runs on hidden dependencies that nobody has written down.',
    signs: [
      'The owner says some version of "only Dave knows how to do that"',
      'There\'s real panic at the idea of a specific person quitting',
      'Cross-training has been talked about for years and never happened',
    ],
    examples: 'The only employee who can run the legacy ordering system. The founder\'s personal Rolodex of customer relationships. The one technician who knows how to recalibrate the equipment.',
  },
  {
    number: '04',
    name: 'Space',
    description: 'Physical space is what\'s limiting throughput. Square footage, display case linear feet, cold storage volume, parking spots — geometry as the binding limit.',
    signs: [
      'Inventory is being stored in hallways or off-site',
      'Customers wait outside, in cars, or leave before being served',
      'Production stages are blocked because the next stage has no room to receive',
    ],
    examples: 'Retail floor or display case. Production floor. Cold storage. Parking. Loading dock. Conference room availability for a service business.',
  },
  {
    number: '05',
    name: 'Demand / Market',
    description: 'The actual constraint is that there aren\'t enough customers. Much less common than owners think — usually under a third of cases — but real when it\'s real.',
    signs: [
      'Resources sit idle even during what should be your peak',
      'Pricing power has eroded — discounting is constant',
      'Sales are flat or declining despite operational improvements',
    ],
    examples: 'A consumer product in a shrinking category. A specialist whose niche is too narrow for the geography. A service business in a depopulating market.',
  },
  {
    number: '06',
    name: 'Time / Scheduling',
    description: 'Operating hours, lead times, production windows, or supplier cadence — the constraint is when things can happen, not whether they can.',
    signs: [
      'You can\'t take orders past a certain time of day',
      'Suppliers deliver on a rhythm that doesn\'t match your demand',
      'Lead times are losing you customers who won\'t wait',
    ],
    examples: 'A bakery whose oven schedule has to start at 3am. A manufacturer who can\'t get parts faster than 6 weeks. A dental practice that can\'t see patients on weekends.',
  },
  {
    number: '07',
    name: 'Cash / Working Capital',
    description: 'The operation could run at higher capacity, but you can\'t fund the inventory, labor, or equipment needed to get there. The bottleneck is on the balance sheet, not the floor.',
    signs: [
      'Stockouts you could prevent if you had cash to pre-buy',
      'Demand is there, but you can\'t hire the next person',
      'Vendor payment terms are dictating operating decisions',
    ],
    examples: 'A growing service business that\'s hire-constrained. A retailer that can\'t stock for seasonal peaks. A manufacturer with long accounts-receivable cycles.',
  },
  {
    number: '08',
    name: 'Policy',
    description: 'An unquestioned rule, habit, or assumption is the real constraint. Goldratt\'s central insight: the physical limit is almost always a symptom of a policy. The fix targets the policy — because changing equipment without changing the policy reproduces the same bottleneck at higher capacity.',
    signs: [
      'A rule that made sense in 2018 still governs decisions in 2026',
      'Nobody can explain why "we do it this way"',
      'The pattern shows up across multiple parts of the business',
    ],
    examples: 'Pricing rules that no longer fit market reality. Production sequencing habits. Capacity planning assumptions. Hiring or scheduling policies that anchor on old constraints.',
  },
];
---

<PageLayout
  title="Categories of Constraints — Unleashing Flow"
  description="Every operating business has a binding constraint. It falls into one of eight categories. Knowing which one is the difference between a fix that works and a fix that moves the problem."
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="hero-label">What we look for</p>
      <h1 class="hero-title">Every business has one binding constraint.</h1>
      <p class="hero-subtitle">
        It falls into one of eight categories. Most owners can name the constraint they <em>think</em> is binding — usually it isn't the one that actually is. The difference matters, because targeting the wrong category produces a fix that doesn't move the system.
      </p>
    </div>
  </section>

  <section class="categories-section section">
    <p class="section-label">The 8 categories</p>
    <h2 class="section-title">Where the constraint usually lives</h2>
    <p class="section-desc">
      In any operating business, the binding constraint at a given moment is in one of these. After Discovery, the constraint protocol checks each.
    </p>

    <div class="category-grid">
      {categories.map(cat => (
        <article class="category-card">
          <span class="category-number">{cat.number}</span>
          <h3 class="category-name">{cat.name}</h3>
          <p class="category-desc">{cat.description}</p>

          <p class="category-section-label">Signs you might have this</p>
          <ul class="category-signs">
            {cat.signs.map(s => <li>{s}</li>)}
          </ul>

          <p class="category-section-label">Examples</p>
          <p class="category-examples">{cat.examples}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="why-one section">
    <div class="why-one-inner">
      <p class="section-label">Why only one</p>
      <h2 class="section-title">The math of bottlenecks</h2>
      <div class="why-one-body">
        <p>
          Imagine a kitchen that can produce 100 meals per hour. The dishwasher can clean 60 plates per hour. The system's throughput is 60 — capped by the slower stage. Upgrade the kitchen to 120 meals per hour and throughput stays at 60. The kitchen improvement bought you nothing.
        </p>
        <p>
          Now upgrade the dishwasher to 120 plates per hour. Throughput jumps to 100 — and the kitchen is now the binding constraint. The bottleneck moved.
        </p>
        <p>
          That isn't a methodology preference. It's arithmetic. The throughput of any pipeline equals the throughput of its slowest stage, always. Improvements to non-slowest stages produce zero throughput change. This is why the constraint protocol spends most of its time figuring out which stage is actually slowest — and why fixing the wrong thing is the most expensive mistake an operator can make.
        </p>
      </div>
    </div>
  </section>

  <section class="policy-note section">
    <div class="policy-note-inner">
      <p class="section-label">A note on policy</p>
      <h2 class="section-title">The physical limit is usually a symptom.</h2>
      <p class="policy-note-body">
        When the constraint work surfaces a limit that looks like equipment or labor, the next question is always: <em>why is that the constraint?</em> Almost always, the answer traces back to a policy — a pricing rule, a scheduling habit, a hiring assumption — that was set years ago against a different operating reality. The fix targets the policy. Replacing the equipment without changing the policy just reproduces the same bottleneck at higher capacity.
      </p>
    </div>
  </section>

  <CTASection
    heading="Want to know which one you have?"
    subtext="Start with Discovery. We listen, check data readiness for integrated reporting or AI, and evaluate your team's skills — then recommend the work that names the binding constraint and what to do about it."
  />
</PageLayout>

<style>
  .page-hero {
    background: var(--charcoal);
    color: var(--ivory);
    padding: 80px 60px 64px;
    text-align: center;
  }

  .page-hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-label {
    font-family: var(--font-heading);
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--terracotta-light);
    margin-bottom: 20px;
    font-weight: 600;
  }

  .hero-title {
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
    color: var(--ivory);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.7;
    color: var(--taupe);
    max-width: 680px;
    margin: 0 auto;
  }

  .hero-subtitle em {
    color: var(--terracotta-light);
    font-style: italic;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .category-card {
    background: #fff;
    border: 1px solid #E8E0D6;
    border-radius: 16px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
  }

  .category-number {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--terracotta);
    display: block;
    margin-bottom: 12px;
  }

  .category-name {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 14px;
    color: var(--charcoal);
    line-height: 1.25;
  }

  .category-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--charcoal);
    margin-bottom: 24px;
  }

  .category-section-label {
    font-family: var(--font-heading);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--warm-gray);
    margin-bottom: 10px;
    font-weight: 600;
  }

  .category-signs {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }

  .category-signs li {
    font-size: 14px;
    color: var(--charcoal);
    padding-left: 18px;
    position: relative;
    line-height: 1.5;
  }

  .category-signs li::before {
    content: '\2192';
    position: absolute;
    left: 0;
    color: var(--terracotta);
    font-weight: 700;
  }

  .category-examples {
    font-size: 14px;
    line-height: 1.6;
    color: var(--warm-gray);
    font-style: italic;
  }

  .why-one {
    background: var(--ivory);
  }

  .why-one-inner {
    max-width: 740px;
    margin: 0 auto;
    text-align: center;
  }

  .why-one-body {
    text-align: left;
    background: #fff;
    border: 1px solid #E8E0D6;
    border-radius: 16px;
    padding: 40px 36px;
    margin-top: 32px;
  }

  .why-one-body p {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.75;
    color: var(--charcoal);
    margin-bottom: 18px;
  }

  .why-one-body p:last-child {
    margin-bottom: 0;
  }

  .policy-note {
    text-align: center;
  }

  .policy-note-inner {
    max-width: 740px;
    margin: 0 auto;
  }

  .policy-note-body {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.75;
    color: var(--charcoal);
    margin-top: 24px;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .policy-note-body em {
    color: var(--terracotta);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 56px 24px 40px;
    }

    .category-grid {
      grid-template-columns: 1fr;
    }

    .why-one-body {
      padding: 28px 22px;
    }
  }
</style>
