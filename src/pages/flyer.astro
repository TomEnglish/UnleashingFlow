---
// Unlinked share page — not in nav, excluded from sitemap, noindex.
// For sharing the print flyer internally and with partners.
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Flyer — Unleashing Flow</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Lora:wght@400&display=swap" rel="stylesheet" />
</head>
<body>
  <main class="flyer-page">
    <div class="toolbar">
      <p class="toolbar-title">Unleashing Flow — One-Page Flyer</p>
      <a class="btn btn-primary" href="/flyer/unleashing-flow-flyer.pdf" download>Download PDF</a>
      <a class="btn btn-ghost" href="/flyer/unleashing-flow-flyer.pdf" target="_blank" rel="noopener">Open / Print</a>
    </div>
    <img class="flyer-img" src="/flyer/flyer-preview.png" alt="Unleashing Flow one-page flyer: Practical AI for Local Businesses — Discovery first, then Fix and Follow Up. Contact Mac Steele or Elliott English." />
  </main>

  <style>
    .flyer-page {
      min-height: 100vh;
      background: var(--ivory-dark);
      padding: 24px 16px 48px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    .toolbar {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .toolbar-title {
      font-family: var(--font-heading);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--warm-gray);
      margin: 0;
    }

    .btn {
      font-family: var(--font-heading);
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      padding: 10px 20px;
      border-radius: 8px;
    }

    .btn-primary {
      background: var(--terracotta);
      color: var(--ivory);
    }

    .btn-ghost {
      border: 1px solid var(--taupe);
      color: var(--charcoal);
    }

    .flyer-img {
      width: 100%;
      max-width: 720px;
      border: 1px solid #E8E0D6;
      border-radius: 8px;
      box-shadow: 0 8px 28px rgba(42, 34, 32, 0.12);
      background: #fff;
    }
  </style>
</body>
</html>
