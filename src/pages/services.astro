---
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/CTASection.astro';

const discoveryDeliverables = [
  'Listening session — what you\'re trying to fix, and what "better" looks like',
  'Data readiness assessment — systems, sources, and whether they can support integrated reporting or AI',
  'Integration map — what connects today, what doesn\'t, and what would need to',
  'Team AI skills evaluation — where your people are strong, where they\'re stuck, and whether training would help',
  'Honest readiness verdict — ready now, ready after a few fixes, or not yet',
  'Recommended next step — scoped only if Discovery says it\'s worth doing',
];

const nextSteps = [
  {
    name: 'Integrated Reporting & Dashboards',
    ask: 'When Discovery says the data can support it.',
    body: 'The view of your operation you should already have but probably don\'t — margin, throughput, capacity, cash — built against live systems once they\'re ready to talk to each other.',
  },
  {
    name: 'AI Builds & Custom Apps',
    ask: 'When Discovery finds a constraint worth fixing with software.',
    body: 'Web apps, native iOS / Android, automations, and AI tools designed for how your operation actually runs — only after we know the data and the workflow can support them.',
  },
  {
    name: 'AI Upskilling',
    ask: 'When Discovery shows the team is the bottleneck, not the stack.',
    body: 'Hands-on training on the tools your people actually need, built around your workflows — with follow-up so adoption sticks instead of fading after the workshop.',
  },
  {
    name: 'Online Presence Revamp',
    ask: 'When the constraint is how customers find you.',
    body: 'Website, local search, and reviews working as one system — when Discovery points at the front door rather than the back office.',
  },
];

const expansion = [
  {
    name: 'Throughput Cycle',
    body: 'The constraint always moves. Once you find and resolve it, a new one becomes binding — that\'s not a flaw, it\'s the system working as designed. The Cycle is the recurring engagement that keeps finding the next constraint: quarterly mini-diagnostic plus a monthly cadence call, with async availability in between.',
    bullets: [
      'Quarterly constraint review',
      'Monthly operating cadence call',
      'Async access between sessions',
      '12-month minimum, renewing',
    ],
  },
  {
    name: 'Fractional AI Officer Retainer',
    body: 'A Chief AI Officer embedded in your business 15–40 hours per month. Senior operational leadership through an AI lens — strategic execution, ongoing throughput improvement, AI tool building, vendor evaluation, team coaching. Without a $200K+ full-time C-suite hire.',
    bullets: [
      'Advisory, Operating, or Embedded engagement depth',
      'Monthly P&L and pipeline review',
      'AI tools built alongside the relationship',
      'Hiring oversight for AI-adjacent roles',
      '6-month minimum, month-to-month thereafter',
    ],
  },
];
---

<PageLayout
  title="Services — Unleashing Flow"
  description="Every engagement starts with Discovery — a Data Readiness Audit that listens to what you need, checks whether your systems are ready for integrated reporting or AI, and evaluates your team's AI skills."
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="hero-label">Services</p>
      <h1 class="hero-title">One way in. Discovery first.</h1>
      <p class="hero-subtitle">
        We don't sell a menu of projects and ask you to pick. Every client starts the same way: we listen to what you need, check whether your systems are ready for integrated reporting or AI, and evaluate whether your team needs training. What comes next is decided by what Discovery finds — not by a sales pitch.
      </p>
    </div>
  </section>

  <section class="discovery-section section">
    <p class="section-label">The entry door</p>
    <h2 class="section-title">Discovery</h2>
    <p class="section-desc discovery-tagline">
      Data Readiness Audit · Team AI Skills Evaluation
    </p>

    <article class="discovery-card">
      <div class="discovery-card-body">
        <div class="discovery-narrative">
          <p class="discovery-lead">
            Discovery is how we work with every client. You tell us what you're trying to fix. We look at whether your current systems can support integrated reporting or AI — and, at the same time, we evaluate your team's AI skills and whether staff training would actually help.
          </p>
          <p>
            Some businesses are ready to build. Some need a few data fixes first. Some need the team brought up to speed before any tool will stick. Discovery tells you which — honestly — before you fund the wrong next step.
          </p>
          <p class="door-shape-line">Fixed-scope first engagement</p>
          <a href="https://calendar.app.google/L5y5Lhqab7ocFmYL6" target="_blank" rel="noopener" class="btn btn-primary door-cta">Book Discovery</a>
        </div>
        <div class="door-deliverables">
          <p class="deliverables-label">What you get</p>
          <ul class="deliverables-list">
            {discoveryDeliverables.map(d => <li>{d}</li>)}
          </ul>
        </div>
      </div>
    </article>
  </section>

  <hr class="divider" />

  <section class="next-steps-section section">
    <p class="section-label">After Discovery</p>
    <h2 class="section-title">What we build when you're ready</h2>
    <p class="section-desc">
      These aren't entry doors. They're the work Discovery may recommend — only when the data, the systems, and the team can support it.
    </p>

    <div class="next-grid">
      {nextSteps.map(step => (
        <article class="next-card">
          <h3 class="next-name">{step.name}</h3>
          <p class="next-ask">{step.ask}</p>
          <p class="next-body">{step.body}</p>
        </article>
      ))}
    </div>
  </section>

  <hr class="divider" />

  <section class="expansion-section section">
    <p class="section-label">Ongoing work</p>
    <h2 class="section-title">Two ways we stay with you</h2>
    <p class="section-desc">
      You're not asked to commit to either upfront. Discovery earns the right to propose what comes next — including longer-term work when it makes sense.
    </p>

    <div class="expansion-grid">
      {expansion.map(item => (
        <div class="expansion-card">
          <h3 class="expansion-name">{item.name}</h3>
          <p class="expansion-body">{item.body}</p>
          <ul class="expansion-bullets">
            {item.bullets.map(b => <li>{b}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <hr class="divider" />

  <section class="pricing-note section">
    <div class="pricing-note-inner">
      <p class="section-label">On pricing</p>
      <h2 class="section-title">Scoped after we listen.</h2>
      <p>
        Discovery is scoped on the call based on complexity and how many systems we need to look at. What follows — if anything — is priced from what Discovery finds, not from a menu. We discuss numbers directly, not on a pricing table.
      </p>
    </div>
  </section>

  <CTASection
    heading="Start with Discovery."
    subtext="Book Discovery and we'll listen to what you need, check whether your systems are ready for integrated reporting or AI, and evaluate your team's AI skills. If we're not a fit, we'll usually be able to point you toward someone who is."
  />
</PageLayout>

<style>
  .page-hero {
    background: var(--charcoal);
    color: var(--ivory);
    padding: 80px 60px 64px;
    text-align: center;
  }

  .page-hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-label {
    font-family: var(--font-heading);
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--terracotta-light);
    margin-bottom: 20px;
    font-weight: 600;
  }

  .hero-title {
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
    color: var(--ivory);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.7;
    color: var(--taupe);
    max-width: 700px;
    margin: 0 auto;
  }

  .discovery-tagline {
    font-family: var(--font-heading) !important;
    font-size: 13px !important;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--terracotta) !important;
  }

  .discovery-card {
    max-width: 1040px;
    margin: 40px auto 0;
    background: #fff;
    border: 1px solid var(--terracotta);
    border-radius: 20px;
    padding: 40px 40px;
  }

  .discovery-card-body {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 36px;
    align-items: start;
  }

  .discovery-lead {
    font-size: 17px !important;
    line-height: 1.7 !important;
    color: var(--charcoal) !important;
    margin-bottom: 16px !important;
  }

  .discovery-narrative p {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--charcoal);
    margin-bottom: 16px;
  }

  .door-shape-line {
    font-family: var(--font-heading) !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--terracotta) !important;
    margin: 16px 0 24px !important;
  }

  .door-cta {
    display: inline-block;
  }

  .door-deliverables {
    background: var(--ivory);
    border-radius: 16px;
    padding: 24px 24px;
  }

  .deliverables-label {
    font-family: var(--font-heading);
    font-size: 11px !important;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 12px !important;
  }

  .deliverables-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .deliverables-list li {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.55;
    color: var(--charcoal);
    padding-left: 20px;
    position: relative;
  }

  .deliverables-list li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--terracotta);
    font-weight: 700;
  }

  .next-grid {
    max-width: 1040px;
    margin: 32px auto 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .next-card {
    background: #fff;
    border: 1px solid #E8E0D6;
    border-radius: 16px;
    padding: 28px 28px;
  }

  .next-name {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 800;
    color: var(--charcoal);
    margin: 0 0 8px;
  }

  .next-ask {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 13px;
    color: var(--warm-gray);
    margin: 0 0 14px;
  }

  .next-body {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.65;
    color: var(--charcoal);
    margin: 0;
  }

  .expansion-grid {
    max-width: 1040px;
    margin: 32px auto 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .expansion-card {
    background: #fff;
    border: 1px solid #E8E0D6;
    border-radius: 16px;
    padding: 32px 32px;
  }

  .expansion-name {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 800;
    color: var(--charcoal);
    margin: 0 0 16px;
  }

  .expansion-body {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--charcoal);
    margin: 0 0 24px;
  }

  .expansion-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .expansion-bullets li {
    font-family: var(--font-heading);
    font-size: 13px;
    color: var(--charcoal);
    padding-left: 20px;
    position: relative;
    line-height: 1.5;
  }

  .expansion-bullets li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--terracotta);
    font-weight: 700;
  }

  .pricing-note-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .pricing-note-inner p {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.75;
    color: var(--charcoal);
    margin-top: 16px;
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 56px 24px 40px;
    }

    .discovery-card {
      padding: 24px 22px;
    }

    .discovery-card-body {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .next-grid,
    .expansion-grid {
      grid-template-columns: 1fr;
    }

    .expansion-card {
      padding: 24px 22px;
    }
  }
</style>
