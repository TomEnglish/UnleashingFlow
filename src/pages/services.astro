---
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/CTASection.astro';

const doors = [
  {
    number: '01',
    name: 'AI Audit',
    ask: 'Where will AI move our bottom line the most?',
    body: 'A focused audit of where AI will produce real dollar impact in your business — not just where it\'s technically possible to deploy. We map your operation end-to-end, identify the highest-value AI opportunities, quantify the expected return, and tell you which one to fund first. The output is the shortlist worth your time, not a list of everything possible.',
    deliverables: [
      'End-to-end value-stream walkthrough',
      'Ranked list of AI opportunities by expected dollar impact',
      'ROI math you can follow — and challenge',
      'Specific recommendation for the first build',
      'Honest "do not automate this yet" list',
      '6–10 page written report, yours to keep',
    ],
    shape: '2 weeks · written report',
  },
  {
    number: '02',
    name: 'Dashboard',
    ask: 'I need to see my business clearly.',
    body: 'The view of your operation you should already have but probably don\'t. We build a clean, fast, role-specific dashboard against your real data — margin by SKU, throughput by hour, capacity by shift, cash discrepancy across locations. Designed for the question you\'re actually trying to answer, not generic BI bloat.',
    deliverables: [
      'Custom dashboard against your live data',
      'CEO view (simple version) or multi-user with role-based access (complex version)',
      'Supabase backend; secure, scalable',
      'Hosted, monitored, ready for daily use',
      'Documentation so your team can extend it',
    ],
    shape: '2–6 week project',
  },
  {
    number: '03',
    name: 'App Development — Web, iPhone, Android',
    ask: 'Build me a tool that\'s mine.',
    body: 'Custom web applications and native iOS / Android apps — software designed for the exact way your operation actually runs. Production planners, intake forms, supplier portals, custom CRMs, field-data capture tools, cash-tracking apps. We start with the workflow, not the technology, and build until it matches how your business should work, not how an off-the-shelf product wants you to work.',
    deliverables: [
      'Web application (Next.js + Supabase) or native iOS/Android app',
      'Certified Apple developer; TestFlight beta workflow',
      'OCR, computer vision, or AI integrations as needed',
      'Secure data architecture (Supabase, role-based auth)',
      'Documented codebase, deployment, and ongoing-support handoff',
    ],
    shape: '4–12 week project',
  },
  {
    number: '04',
    name: 'AI Upskilling',
    ask: 'Train my team on AI tools.',
    body: 'Workshops and hands-on training on the specific AI tools your team needs — built around your actual workflows, not generic prompt-engineering theatre. Half-day or full-day formats, on-site or remote, with a 90-day follow-up to make sure adoption sticks instead of fading after the workshop high wears off.',
    deliverables: [
      'Pre-workshop assessment of your team\'s current AI usage',
      'Custom curriculum built on your tools and workflows',
      'Hands-on exercises with your real data',
      'Reference guide team can return to after the session',
      '90-day follow-up to measure adoption and adjust',
    ],
    shape: '1–3 days + 90-day follow-up',
  },
];

const expansion = [
  {
    name: 'Throughput Cycle',
    body: 'The constraint always moves. Once you find and resolve it, a new one becomes binding — that\'s not a flaw, it\'s the system working as designed. The Cycle is the recurring engagement that keeps finding the next constraint: quarterly mini-diagnostic plus a monthly cadence call, with async availability in between.',
    bullets: [
      'Quarterly constraint review',
      'Monthly operating cadence call',
      'Async access between sessions',
      '12-month minimum, renewing',
    ],
  },
  {
    name: 'Fractional AI Officer Retainer',
    body: 'A Chief AI Officer embedded in your business 15–40 hours per month. Senior operational leadership through an AI lens — strategic execution, ongoing throughput improvement, AI tool building, vendor evaluation, team coaching. Without a $200K+ full-time C-suite hire.',
    bullets: [
      'Advisory, Operating, or Embedded engagement depth',
      'Monthly P&L and pipeline review',
      'AI tools built alongside the relationship',
      'Hiring oversight for AI-adjacent roles',
      '6-month minimum, month-to-month thereafter',
    ],
  },
];
---

<PageLayout
  title="Services — Unleashing Flow"
  description="Fractional AI Officer, AI Audit, custom dashboards, web and mobile app development, and AI upskilling for owner-operated businesses doing $2M to $20M."
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="hero-label">Services</p>
      <h1 class="hero-title">Four ways to begin. Two ways to keep going.</h1>
      <p class="hero-subtitle">
        You don't sign up for a long engagement. You buy a first piece of work — fixed scope, fixed timeline — and decide what's next. After the first engagement, most clients want either a recurring cycle or an embedded Fractional AI Officer.
      </p>
    </div>
  </section>

  <section class="entry-doors-section section">
    <p class="section-label">Where you start</p>
    <h2 class="section-title">The four entry doors</h2>
    <p class="section-desc">
      Each is a fixed-scope, fixed-fee first engagement. Most produce direct ROI you can measure inside a few weeks. All of them tell you whether ongoing senior operational help is worth the investment.
    </p>

    <div class="doors-stack">
      {doors.map(door => (
        <article class="door-row">
          <div class="door-row-head">
            <span class="door-row-num">{door.number}</span>
            <div>
              <h3 class="door-row-name">{door.name}</h3>
              <p class="door-row-ask">{door.ask}</p>
            </div>
          </div>
          <div class="door-row-body">
            <div class="door-narrative">
              <p>{door.body}</p>
              <p class="door-shape-line">{door.shape}</p>
              <a href="https://calendly.com/elliott-english/discovery-call" target="_blank" rel="noopener" class="btn btn-outline door-cta">Discuss this engagement</a>
            </div>
            <div class="door-deliverables">
              <p class="deliverables-label">What you get</p>
              <ul class="deliverables-list">
                {door.deliverables.map(d => <li>{d}</li>)}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <hr class="divider" />

  <section class="expansion-section section">
    <p class="section-label">After the first piece of work</p>
    <h2 class="section-title">Two ways we work together long-term</h2>
    <p class="section-desc">
      You're not asked to commit to either upfront. The first engagement earns the right to propose the second.
    </p>

    <div class="expansion-grid">
      {expansion.map(item => (
        <div class="expansion-card">
          <h3 class="expansion-name">{item.name}</h3>
          <p class="expansion-body">{item.body}</p>
          <ul class="expansion-bullets">
            {item.bullets.map(b => <li>{b}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <hr class="divider" />

  <section class="pricing-note section">
    <div class="pricing-note-inner">
      <p class="section-label">On pricing</p>
      <h2 class="section-title">Scoped per engagement, sized to your business.</h2>
      <p>
        Engagements are scoped during the discovery call based on business size, complexity, urgency, and data readiness. A $3M owner-operated practice and a $20M multi-location operation should not pay the same price for the same audit — and they don't. We discuss numbers directly on the call, not on a pricing table.
      </p>
    </div>
  </section>

  <CTASection
    heading="Which door fits your business?"
    subtext="Thirty-minute discovery call — free, no pitch. We'll talk through what you're trying to fix, which door makes sense as the first engagement, and what comes after. If we're not a fit, we'll usually be able to point you toward someone who is."
  />
</PageLayout>

<style>
  .page-hero {
    background: var(--charcoal);
    color: var(--ivory);
    padding: 80px 60px 64px;
    text-align: center;
  }

  .page-hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-label {
    font-family: var(--font-heading);
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--terracotta-light);
    margin-bottom: 20px;
    font-weight: 600;
  }

  .hero-title {
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
    color: var(--ivory);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.7;
    color: var(--taupe);
    max-width: 700px;
    margin: 0 auto;
  }

  /* Doors */
  .doors-stack {
    max-width: 1040px;
    margin: 40px auto 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .door-row {
    background: #fff;
    border: 1px solid #E8E0D6;
    border-radius: 20px;
    padding: 36px 36px;
  }

  .door-row-head {
    display: flex;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #E8E0D6;
  }

  .door-row-num {
    font-family: var(--font-heading);
    font-size: 36px;
    font-weight: 800;
    color: var(--terracotta);
    line-height: 1;
    flex-shrink: 0;
    min-width: 56px;
  }

  .door-row-name {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 800;
    color: var(--charcoal);
    margin: 0 0 6px;
    line-height: 1.2;
  }

  .door-row-ask {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 14px;
    color: var(--warm-gray);
    margin: 0;
    letter-spacing: 0.3px;
  }

  .door-row-body {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 36px;
    align-items: start;
  }

  .door-narrative p {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--charcoal);
    margin-bottom: 16px;
  }

  .door-shape-line {
    font-family: var(--font-heading) !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--terracotta) !important;
    margin: 16px 0 24px !important;
  }

  .door-cta {
    display: inline-block;
  }

  .door-deliverables {
    background: var(--ivory);
    border-radius: 16px;
    padding: 24px 24px;
  }

  .deliverables-label {
    font-family: var(--font-heading);
    font-size: 11px !important;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 12px !important;
  }

  .deliverables-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .deliverables-list li {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.55;
    color: var(--charcoal);
    padding-left: 20px;
    position: relative;
  }

  .deliverables-list li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--terracotta);
    font-weight: 700;
  }

  /* Expansion */
  .expansion-grid {
    max-width: 1040px;
    margin: 32px auto 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .expansion-card {
    background: #fff;
    border: 1px solid #E8E0D6;
    border-radius: 16px;
    padding: 32px 32px;
  }

  .expansion-name {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 800;
    color: var(--charcoal);
    margin: 0 0 16px;
  }

  .expansion-body {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--charcoal);
    margin: 0 0 24px;
  }

  .expansion-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .expansion-bullets li {
    font-family: var(--font-heading);
    font-size: 13px;
    color: var(--charcoal);
    padding-left: 20px;
    position: relative;
    line-height: 1.5;
  }

  .expansion-bullets li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--terracotta);
    font-weight: 700;
  }

  /* Pricing note */
  .pricing-note-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .pricing-note-inner p {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.75;
    color: var(--charcoal);
    margin-top: 16px;
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 56px 24px 40px;
    }

    .door-row {
      padding: 24px 22px;
    }

    .door-row-head {
      gap: 16px;
    }

    .door-row-num {
      font-size: 28px;
      min-width: 40px;
    }

    .door-row-name {
      font-size: 22px;
    }

    .door-row-body {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .expansion-grid {
      grid-template-columns: 1fr;
    }

    .expansion-card {
      padding: 24px 22px;
    }
  }
</style>
