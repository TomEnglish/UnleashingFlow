---
import DigestLayout from '../../layouts/DigestLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const digests = await getCollection('digests');
  return digests.map(digest => ({
    params: { slug: digest.id },
    props: { digest },
  }));
}

const { digest } = Astro.props;
const { Content } = await render(digest);
---

<DigestLayout
  title={digest.data.title}
  date={digest.data.date}
  description={digest.data.description}
  audioFile={digest.data.audioFile}
>
  <Content />
</DigestLayout>
